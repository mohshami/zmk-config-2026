#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        CtrlZ: CtrlZ {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRLZ";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };

        AltF: AltF {
            compatible = "zmk,behavior-hold-tap";
            label = "ALTF";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };

        j_tilde: j_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp TILDE>;

            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        i_tab: i_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp TAB>;

            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
            label = "I_TAB";
        };

        k_grave: k_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp GRAVE>;

            label = "K_GRAVE";
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        AltCtrlDel {
            bindings = <&kp LA(LC(DEL))>;
            key-positions = <41 40 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q           &kp W  &kp E     &kp R             &kp T        &kp Y    &kp U     &i_tab     &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A           &kp S  &kp D     &AltF LEFT_ALT F  &kp G        &kp H    &j_tilde  &k_grave   &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &CtrlZ LCTRL Z  &kp X  &kp C     &kp V             &kp B        &kp N    &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                  &kp LGUI  &mo 1             &kp SPACE    &kp RET  &mo 2     &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp EXCL        &kp AT        &kp HASH      &kp DLLR          &kp PRCNT       &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR   &kp RPAR  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3      &bt BT_SEL 4    &kp LEFT   &kp DOWN  &kp UP           &kp RIGHT  &trans    &trans
&kp LSHFT   &bt BT_CLR_ALL  &trans        &trans        &kp K_PLAY_PAUSE  &caps_word      &trans     &trans    &trans           &trans     &trans    &trans
                                          &kp LGUI      &trans            &kp SPACE       &kp RET    &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp N1  &kp N2  &kp N3    &kp N4     &kp N5       &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp DELETE
&kp LCTRL  &trans  &trans  &trans    &mkp LCLK  &trans       &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans  &trans  &trans    &trans     &trans       &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
                           &kp LGUI  &trans     &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };
    };
};
